# Disable MultiViews to prevent conflicts
Options -MultiViews
RewriteEngine On
RewriteBase /nar8tive/

# ============================================================
# This RewriteBase works for local XAMPP (localhost/nar8tive/).
# Before deploying to production, change it to: RewriteBase /
# OR use the deploy script to swap it automatically.
# ============================================================

# 1. External Redirect: .html -> Clean URL (SEO)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.html [NC]
RewriteRule ^ %1 [R=301,L]

# Redirect .php -> clean URL
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# 2. Internal Rewrite: Clean URL -> Actual File
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)/?$ $1.php [L]

# Optional: Force HTTPS (uncomment on production)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
